# 1. MULAI PROGRAM APLIKASI KASIR RESTORAN
print("     APLIKASI KASIR RESTORAN MODERN      ")

total_belanja = 0

# 2. PERULANGAN UNTUK PROSES PEMESANAN (WHILE LOOP)
while True:
    # Menampilkan Menu Makanan
    print("\n--- DAFTAR MENU MAKANAN ---")
    print("1. Nasi Goreng  - Rp 25.000")
    print("2. Mie Ayam     - Rp 15.000")
    print("3. Ayam Geprek  - Rp 20.000")
    print("4. Sate Ayam    - Rp 30.000")
    print("5. Bakso        - Rp 18.000")
    print("0. Selesai Memilih")
    
    # 3. Proses Pemesanan (Input dari Pengguna)
    pilihan = input("Pilih menu (0-5): ")
    
    # 4. Percabangan Cek Apakah Pilihan 0? (Kondisi Keluar Loop)
    if pilihan == "0":
        print("Pemesanan selesai. Memproses pembayaran...")
        break # Keluar dari perulangan
        
    # Menentukan harga berdasarkan pilihan menu menggunakan if-elif-else
    if pilihan == "1":
        nama_menu = "Nasi Goreng"
        harga = 25000
    elif pilihan == "2":
        nama_menu = "Mie Ayam"
        harga = 15000
    elif pilihan == "3":
        nama_menu = "Ayam Geprek"
        harga = 20000
    elif pilihan == "4":
        nama_menu = "Sate Ayam"
        harga = 30000
    elif pilihan == "5":
        nama_menu = "Bakso"
        harga = 18000
    else:
        print("Pilihan tidak valid! Silakan pilih menu yang tersedia.")
        continue # Lewati sisa kode dan kembali ke awal loop
        
    # Input jumlah pesanan dan hitung subtotal
    jumlah = int(input(f"Masukkan jumlah {nama_menu} yang dibeli: "))
    subtotal = harga * jumlah
    
    # Menambahkan subtotal ke total belanja keseluruhan
    total_belanja += subtotal
    print(f"Berhasil menambahkan: {jumlah} {nama_menu} (Subtotal: Rp {subtotal:,})")

# 5. HITUNG DISKON (PERCABANGAN IF-ELSE)
if total_belanja > 200000:
    persen_diskon = 20
    potongan_harga = int(total_belanja * 0.20)
else:
    persen_diskon = 0
    potongan_harga = 0

# Hitung total akhir yang harus dibayar
total_bayar = int(total_belanja - potongan_harga)

# 6. TAMPILKAN STRUK PEMBAYARAN
print("            STRUK PEMBAYARAN             ")
print(f"Total Belanja : Rp {total_belanja:,}")
print(f"Diskon        : {persen_diskon}%")
print(f"Potongan      : Rp {potongan_harga:,}")
print("-----------------------------------------")
print(f"Total Bayar   : Rp {total_bayar:,}")
print("              TERIMA KASIH               ")